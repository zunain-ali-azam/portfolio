---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Zunain Ali Azam — Software Engineer working across frontend and full-stack web development with Next.js, Angular, Node.js, Nest.js, and TypeScript.',
  image = '/og-image.png',
  type = 'website',
} = Astro.props;

const siteTitle = title === 'Zunain Ali Azam' ? title : `${title} | Zunain Ali Azam`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Structured data so search engines can connect the name, role, skills and profiles
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Zunain Ali Azam',
  jobTitle: 'Software Engineer',
  description: 'Full-stack software engineer and co-founder of Calyndrs, based in Karachi, open to remote work and relocation. Works across web apps (Next.js, Angular, Node.js, Nest.js, TypeScript), machine learning and technical SEO.',
  url: Astro.site?.toString(),
  image: new URL('/og-image.png', Astro.site).toString(),
  email: 'mailto:zunainazam456@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Karachi', addressCountry: 'PK' },
  worksFor: { '@type': 'Organization', name: 'IOMechs', url: 'https://iomechs.com' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Karachi' },
  knowsAbout: [
    'Next.js', 'Angular', 'React', 'Node.js', 'Nest.js', 'TypeScript',
    'Technical SEO', 'Framework migrations', 'Internationalization (i18n)', 'Right-to-left (RTL) interfaces',
    'Dashboards', 'Vitest', 'Playwright', 'Machine learning', 'BERT', 'Natural language processing',
  ],
  sameAs: [
    'https://github.com/zunain-ali-azam',
    'https://linkedin.com/in/zunain-azam',
    'https://zunainaliazam.medium.com',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Primary SEO -->
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content="Zunain Ali Azam" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    <!-- Vercel Web Analytics: cookieless page views, only reports on Vercel deployments -->
    <Analytics />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Readex+Pro:HEXP,wght@0..100,160..700&display=swap"
      rel="stylesheet"
    />

    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        let stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        const pref = stored === 'light' || stored === 'dark' ? stored : 'system';
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = pref === 'dark' || (pref === 'system' && prefersDark);
        document.documentElement.dataset.themePref = pref;
        document.documentElement.classList.toggle('dark', isDark);
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- iOS Safari only shows :active press states once the page listens for touches -->
    <script is:inline>
      document.addEventListener('touchstart', function () {}, { passive: true });
    </script>

    <script is:inline>
      // Scroll reveals. What's on screen at load animates in order; the rest waits until it's a little way
      // into the viewport. When the visitor is scrolling fast, content appears instantly instead.
      (function () {
        const els = document.querySelectorAll('[data-reveal]');
        // Reduced motion still gets a plain fade (handled in CSS), so only bail out without IntersectionObserver
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Scroll speed in px/ms, measured over the last 100ms of scrolling. A window is steadier than
        // per-event deltas, which spike when two scroll events land in the same millisecond.
        const samples = [];
        let settleTimer;
        addEventListener('scroll', () => {
          const now = performance.now();
          samples.push([now, scrollY]);
          while (samples.length > 2 && now - samples[0][0] > 100) samples.shift();
          clearTimeout(settleTimer);
          settleTimer = setTimeout(settle, 150);
        }, { passive: true });
        const speed = () => {
          const now = performance.now();
          if (samples.length < 2 || now - samples[samples.length - 1][0] > 150) return 0; // stopped
          const [t0, y0] = samples[0], [t1, y1] = samples[samples.length - 1];
          return Math.abs(y1 - y0) / Math.max(t1 - t0, 16);
        };
        const FAST = 1.2; // ~1200px/s: faster than reading, so skip the animation

        // Stats count up from zero, keeping any suffix ("10+", "99")
        const countUp = (el) => {
          const [, num, rest] = el.textContent.trim().match(/^(\d+)(.*)$/) || [];
          if (!num) return;
          const target = +num, start = performance.now(), duration = 1400;
          const step = (now) => {
            const t = Math.min((now - start) / duration, 1);
            el.textContent = Math.round(target * (1 - Math.pow(2, -10 * t))) + rest;
            if (t < 1) requestAnimationFrame(step);
            else el.textContent = target + rest;
          };
          requestAnimationFrame(step);
        };

        const pending = new Set();
        const reveal = (el, i, fast) => {
          if (fast) el.classList.add('reveal-instant');
          // Elements can set their own delay (hero, headings); others get a short, capped stagger
          else if (!el.style.getPropertyValue('--reveal-delay')) el.style.setProperty('--reveal-delay', `${Math.min(i, 3) * 80}ms`);
          el.classList.add('is-in');
          if (!fast && !still) el.querySelectorAll('[data-count]').forEach(countUp);
          io.unobserve(el);
          pending.delete(el);
        };
        const io = new IntersectionObserver((entries) => {
          const fast = speed() > FAST;
          entries.filter((e) => e.isIntersecting).forEach((entry, i) => reveal(entry.target, i, fast));
        }, { threshold: 0, rootMargin: '0px 0px -10% 0px' });
        // Reveals wait until content is 10% into the screen; once scrolling stops, show anything
        // still waiting in that bottom strip so nothing sits blank while the visitor reads
        function settle() {
          [...pending].filter((el) => el.getBoundingClientRect().top < innerHeight).forEach((el, i) => reveal(el, i, false));
        }
        const onScreen = [];
        els.forEach((el) => {
          if (el.getBoundingClientRect().top < innerHeight) onScreen.push(el);
          else { pending.add(el); io.observe(el); }
        });
        // Two frames so the hidden state paints first and the transition actually runs
        requestAnimationFrame(() => requestAnimationFrame(() => onScreen.forEach((el, i) => reveal(el, i, false))));
      })();
    </script>
  </body>
</html>
