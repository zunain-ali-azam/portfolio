---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await project.render();

const { title, description, tech, category, github, live, yearCompleted, highlights, image, employer, role } = project.data;
const isLogo = image?.toLowerCase().includes('logo');
---

<BaseLayout title={title} description={description} image={image && !image.endsWith('.svg') ? image : undefined}>
  <article class="container">
    <header class="pt-10 sm:pt-16 pb-12">
      <a href="/projects" class="link text-[0.9375rem]">All work</a>
      <h1 class="type-page mt-8" style={`view-transition-name: project-title-${project.slug}`}>{title}</h1>
      <p class="mt-6 max-w-[60ch] text-lg sm:text-xl text-ink/80 leading-relaxed">{description}</p>
      {(live || github) && (
        <div class="mt-8 flex flex-wrap gap-3">
          {live && <a href={live} target="_blank" rel="noopener noreferrer" class="btn-primary">Visit live site</a>}
          {github && <a href={github} target="_blank" rel="noopener noreferrer" class="btn-secondary">View source</a>}
        </div>
      )}
    </header>

    {image && (
      <figure
        class:list={[
          'aspect-[16/8] rounded-xl overflow-hidden border border-rule flex items-center justify-center',
          isLogo ? 'bg-white' : 'bg-tint',
        ]}
        style={`view-transition-name: project-image-${project.slug}`}
      >
        <img
          src={image}
          alt={`${title} screenshot`}
          class:list={['w-full h-full', isLogo ? 'object-contain p-12' : 'object-cover object-top']}
          loading="eager"
        />
      </figure>
    )}

    <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-20">
      <div class="min-w-0 max-w-[68ch]">
        {highlights.length > 0 && (
          <section class="mb-12">
            <h2 class="type-section mb-5">Highlights</h2>
            <ul class="bullets space-y-3 text-[1.0625rem]">
              {highlights.map((h) => <li>{h}</li>)}
            </ul>
          </section>
        )}
        <div class="prose-site">
          <Content />
        </div>
      </div>

      <aside class="lg:sticky lg:top-24 self-start rounded-xl bg-tint p-6">
        <dl class="space-y-4">
          <div><dt class="text-sm text-mut">Year</dt><dd>{yearCompleted}</dd></div>
          {role && <div><dt class="text-sm text-mut">Role</dt><dd>{role}</dd></div>}
          {employer && <div><dt class="text-sm text-mut">Built at</dt><dd>{employer}</dd></div>}
          <div><dt class="text-sm text-mut">Type</dt><dd>{category.join(', ')}</dd></div>
          <div><dt class="text-sm text-mut">Stack</dt><dd>{tech.join(', ')}</dd></div>
        </dl>
      </aside>
    </div>

    {next && next.slug !== project.slug && (
      <a href={`/projects/${next.slug}`} class="group mt-24 block border-t border-rule pt-6">
        <span class="text-mut">Next project</span>
        <span class="block mt-2 type-page group-hover:text-accent transition-colors">{next.data.title}</span>
      </a>
    )}
  </article>
</BaseLayout>
