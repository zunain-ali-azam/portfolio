---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Faq from '@/components/Faq.astro';
import type { FaqSection } from '@/data/faqs';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await project.render();

const { title, description, metaTitle, metaDescription, tech, category, github, live, yearCompleted, highlights, image, ogImage, employer, role, myPart, team } = project.data;
const isLogo = image?.toLowerCase().includes('logo');

// Questions drawn from this project's own details, so each page asks and answers something different
const faq: FaqSection = {
  title: `Questions about ${title}`,
  faqs: [
    employer
      ? {
          q: `Did you build ${title} on your own?`,
          a: `No. ${title} is an ${employer} product built by a team. My part: ${myPart ?? 'the contributions listed above'}`,
        }
      : team
        ? {
            q: `Did you build ${title} on your own?`,
            a: `No, it was a team effort${role ? `, and I'm one of its ${role.toLowerCase()}s` : ''}. I was part of it from the first idea to launch; the highlights above are my contributions.`,
          }
        : {
            q: `Did you build ${title} yourself?`,
            a: 'Yes, it’s a solo project, built from start to finish by me.',
          },
    {
      q: `What is ${title} built with?`,
      a: `${tech.join(', ')}.`,
    },
    live || github
      ? {
          q: `Can I try ${title} or see the code?`,
          a: [
            live && `It’s live at <a class="link" href="${live}" target="_blank" rel="noopener noreferrer">${new URL(live).host}</a>.`,
            github && `The code is on <a class="link" href="${github}" target="_blank" rel="noopener noreferrer">GitHub</a>.`,
            employer && !github && `The code belongs to ${employer}, so I can’t share it, but I can walk you through my part on a call.`,
          ].filter(Boolean).join(' '),
        }
      : null,
    {
      q: `Could you build something like ${title} for us?`,
      a: employer
        ? `The product belongs to ${employer}, but the experience comes with me. Tell me what you’re building and where it’s stuck, and I’ll tell you honestly how close it is to my work on ${title}.`
        : `Yes. Tell me what you need and how it differs from ${title}, and we can work out the scope together.`,
    },
  ].filter((f): f is { q: string; a: string } => f !== null),
  cta: employer
    ? { title: `Need work like my part on ${title}?`, text: 'Tell me about your product and what it needs next. A 30-minute call is enough to see if I can help.' }
    : { title: `Want something like ${title}?`, text: `Book a call and tell me what you have in mind. We can see what of ${title} carries over to yours.` },
};

const pageUrl = new URL(`/projects/${project.slug}`, Astro.site).toString();
const jsonLd = [
  {
    '@type': 'CreativeWork',
    name: title,
    description,
    url: pageUrl,
    ...(image && { image: new URL(image, Astro.site).toString() }),
    keywords: tech.join(', '),
    // Team projects credit me as a contributor, solo ones as the creator
    [employer || team ? 'contributor' : 'creator']: { '@id': new URL('/#person', Astro.site).toString() },
    ...(employer && { producer: { '@type': 'Organization', name: employer } }),
    ...((live || github) && { sameAs: live ?? github }),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Work', item: new URL('/projects', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={metaTitle ?? title}
  description={metaDescription ?? description}
  image={ogImage}
  jsonLd={jsonLd}
>
  <article class="container">
    <header class="pt-10 sm:pt-16 pb-12">
      <a href="/projects" class="link text-[0.9375rem]">All work</a>
      <h1 class="type-page mt-8" style={`view-transition-name: project-title-${project.slug}`}>{title}</h1>
      <p class="mt-6 max-w-[60ch] text-lg sm:text-xl text-ink/80 leading-relaxed">{description}</p>
      {(employer || team) && (
        <p class="mt-4 max-w-[60ch] text-mut">
          {employer
            ? `Built at ${employer} as part of a team. The highlights below are my own contributions.`
            : 'Built by a team, and I was part of it from the first idea to launch. The highlights below are my own contributions.'}
        </p>
      )}
      {(live || github) && (
        <div class="mt-8 flex flex-wrap gap-3">
          {live && <a href={live} target="_blank" rel="noopener noreferrer" class="btn-primary">Visit live site</a>}
          {github && <a href={github} target="_blank" rel="noopener noreferrer" class="btn-secondary">View source</a>}
        </div>
      )}
    </header>

    {image && (
      <figure
        class:list={[
          'aspect-[16/8] rounded-2xl overflow-hidden border border-rule flex items-center justify-center',
          isLogo ? 'bg-white' : 'bg-tint',
        ]}
        style={`view-transition-name: project-image-${project.slug}`}
      >
        <img
          src={image}
          alt={isLogo ? `${title} logo` : `${title} screenshot`}
          width="1600"
          height="800"
          class:list={['w-full h-full', isLogo ? 'object-contain p-12' : 'object-cover object-top']}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    )}

    <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-20">
      <div class="min-w-0 max-w-[68ch]">
        {highlights.length > 0 && (
          <section class="mb-12">
            <h2 class="type-section mb-5">Highlights</h2>
            <ul class="bullets space-y-3 text-[1.0625rem]">
              {highlights.map((h) => <li>{h}</li>)}
            </ul>
          </section>
        )}
        <div class="prose-site">
          <Content />
        </div>
      </div>

      <aside class="lg:sticky lg:top-24 self-start rounded-2xl bg-tint p-6">
        <dl class="space-y-4">
          <div><dt class="text-sm text-mut">Year</dt><dd>{yearCompleted}</dd></div>
          {role && <div><dt class="text-sm text-mut">Role</dt><dd>{role}</dd></div>}
          {employer && <div><dt class="text-sm text-mut">Built at</dt><dd>{employer}</dd></div>}
          <div><dt class="text-sm text-mut">Type</dt><dd>{category.join(', ')}</dd></div>
          <div><dt class="text-sm text-mut">Stack</dt><dd>{tech.join(', ')}</dd></div>
        </dl>
      </aside>
    </div>

    {next && next.slug !== project.slug && (
      <a href={`/projects/${next.slug}`} class="group mt-24 block border-t border-rule pt-6">
        <span class="text-mut">Next project</span>
        <span class="block mt-2 type-page group-hover:text-accent transition-colors">{next.data.title}</span>
      </a>
    )}
  </article>

  <Faq section={faq} />
</BaseLayout>
