---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sorted = allProjects.sort((a, b) => a.data.order - b.data.order);

const categories = ['All', ...new Set(allProjects.flatMap((p) => p.data.category))];
---

<BaseLayout
  title="Projects"
  description="A collection of full-stack and frontend projects by Zunain Ali Azam — across SaaS platforms, telemedicine, EdTech, real estate, and on-demand services."
>
  <div class="container">
    <PageHeader
      title="Work"
      intro="Production platforms I work on at IOMechs, and my own products, from event management and telemedicine to EdTech and real estate."
    />

    <div class="flex flex-wrap items-center gap-2" id="filter-bar" role="group" aria-label="Filter projects by type">
      {categories.map((cat) => (
        <button
          type="button"
          class="filter-btn press rounded-md px-3 py-1.5 text-[0.9375rem] border border-control text-ink hover:border-ink transition-[color,background-color,border-color,transform] duration-100 active:scale-[0.96] aria-pressed:bg-ink aria-pressed:text-paper aria-pressed:border-ink"
          data-category={cat}
          aria-pressed={cat === 'All' ? 'true' : 'false'}
        >
          {cat}
        </button>
      ))}
    </div>

    <div class="mt-8 border-b border-rule" id="projects-list">
      {sorted.map((project) => (
        <div data-categories={project.data.category.join(',')}>
          <ProjectRow
            title={project.data.title}
            description={project.data.description}
            tech={project.data.tech}
            slug={project.slug}
            yearCompleted={project.data.yearCompleted}
            image={project.data.image}
          />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#filter-bar .filter-btn');
  const rows = document.querySelectorAll<HTMLElement>('#projects-list [data-categories]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const active = btn.dataset.category ?? 'All';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      rows.forEach((row) => {
        const cats = row.dataset.categories?.split(',') ?? [];
        row.hidden = !(active === 'All' || cats.includes(active));
      });
    });
  });
</script>
