---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <div class="container pt-12 sm:pt-20">
    <p class="type-hero !text-[clamp(6rem,26vw,16rem)] !leading-none text-accent" aria-hidden="true">404</p>
    <h1 class="type-section mt-6">This page doesn't exist</h1>
    <p class="mt-3 text-ink/80 max-w-[56ch]">
      Nothing lives at <code id="missing-path" class="font-mono text-[0.9em] px-1.5 py-0.5 rounded bg-tint break-all">this address</code>.
      It may have moved, or the link has a typo.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Go to home</a>
      <a href="/projects" class="btn-secondary">See my work</a>
    </div>
  </div>
</BaseLayout>

<script>
  const el = document.getElementById('missing-path');
  if (el && location.pathname !== '/404') el.textContent = location.pathname;
</script>
