---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
---

<BaseLayout
  title="Resume"
  description="Resume of Zunain Ali Azam — Software Engineer working across frontend and full-stack web development with Next.js, Angular, Node.js, Nest.js, and TypeScript."
>
  <div class="container">
    <PageHeader title="Resume">
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/resume.pdf" download="Zunain Ali Azam - Resume.pdf" class="btn-primary">Download PDF</a>
        <a href="/resume.pdf" target="_blank" rel="noopener" class="btn-secondary">Open in a new tab</a>
      </div>
    </PageHeader>

    <iframe
      src="/resume.pdf"
      title="Zunain Ali Azam, resume"
      class="w-full block rounded-xl border border-rule bg-white"
      style="height: 85vh; min-height: 600px;"
    ></iframe>
  </div>
</BaseLayout>
