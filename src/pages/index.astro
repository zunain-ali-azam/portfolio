---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import HowICanHelp from '@/components/HowICanHelp.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import PostRow from '@/components/PostRow.astro';
import ProjectFeature from '@/components/ProjectFeature.astro';
import ExperienceTimeline from '@/components/ExperienceTimeline.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '@/lib/format';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const atWork = projects.filter((p) => p.data.employer);
const ownBuilds = projects.filter((p) => !p.data.employer);

// Screenshots get the large treatment; logo-only or image-less projects stay as compact rows
const hasScreenshot = (p: (typeof projects)[number]) => !!p.data.image && !p.data.image.toLowerCase().includes('logo');

const projectGroups = [
  { title: 'Products I work on at IOMechs', intro: 'Live platforms with real users, where I work on dashboards, framework migrations and bilingual UI.', items: atWork },
  { title: 'Things I built end to end', intro: 'Full-stack products I designed, built and shipped myself.', items: ownBuilds },
];

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="Full-Stack Software Engineer"
  description="Zunain Ali Azam, full-stack software engineer in Karachi, open to remote work and relocation. Web apps in Next.js, Angular and Node.js, machine learning and technical SEO."
>
  <Hero />

  <div class="container pt-20 sm:pt-24 space-y-24 sm:space-y-28">
    <section>
      <SectionHeader title="Problems I can take off your plate" intro="Each one is something I've already solved, with a link to the work." />
      <HowICanHelp />
    </section>

    {projectGroups.map(({ title, intro, items }, i) => items.length > 0 && (
      <section>
        <SectionHeader title={title} intro={intro} href={i === 0 ? '/projects' : undefined} linkLabel="All projects" />
        <div class="grid gap-x-8 gap-y-12 md:grid-cols-2">
          {items.filter(hasScreenshot).map((project) => (
            <ProjectFeature
              title={project.data.title}
              description={project.data.description}
              tech={project.data.tech}
              slug={project.slug}
              yearCompleted={project.data.yearCompleted}
              image={project.data.image!}
            />
          ))}
        </div>
        {items.some((p) => !hasScreenshot(p)) && (
          <div class="mt-12 border-b border-rule">
            {items.filter((p) => !hasScreenshot(p)).map((project) => (
              <ProjectRow
                title={project.data.title}
                description={project.data.description}
                tech={project.data.tech}
                slug={project.slug}
                yearCompleted={project.data.yearCompleted}
                image={project.data.image}
              />
            ))}
          </div>
        )}
      </section>
    ))}

    <section>
      <SectionHeader title="Experience" href="/experience" linkLabel="Full history" />
      <ExperienceTimeline preview />
    </section>

    {posts.length > 0 && (
      <section>
        <SectionHeader title="Writing" href="/blog" linkLabel="All posts" />
        <div class="border-b border-rule">
          {posts.map((post) => (
            <PostRow
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              slug={post.slug}
              minutes={readingTime(post.body)}
            />
          ))}
        </div>
      </section>
    )}

    <section class="rounded-xl bg-tint px-6 py-10 sm:px-12 sm:py-14 flex flex-wrap items-end justify-between gap-8">
      <div>
        <h2 class="type-section max-w-[28ch]">Hiring, or need something built?</h2>
        <p class="mt-3 text-ink/80 max-w-[52ch]">Whether it's a full-time role or a freelance project, tell me what you're working on.</p>
      </div>
      <a href="/contact" class="btn-primary">Get in touch</a>
    </section>
  </div>
</BaseLayout>
