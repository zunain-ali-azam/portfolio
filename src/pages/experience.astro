---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ExperienceTimeline from '@/components/ExperienceTimeline.astro';
import Faq from '@/components/Faq.astro';
import { experienceFaqs } from '@/data/faqs';
---

<BaseLayout
  title="Experience"
  description="Work history of Zunain Ali Azam, full-stack developer: co-founder of Calyndrs, software engineer at IOMechs, and frontend roles before that."
>
  <div class="container">
    <PageHeader
      title="Experience"
      intro="From an internship building hiring flows to leading framework migrations, building bilingual platforms and co-founding a product."
    />

    <ExperienceTimeline />

    <p class="mt-14 text-ink/80">
      Education: B.S. Computer Science, University of Karachi, 2021 to 2024.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/resume" class="btn-secondary">Resume (PDF)</a>
    </div>
  </div>

  <Faq section={experienceFaqs} />
</BaseLayout>
