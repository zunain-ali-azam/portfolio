---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ExperienceTimeline from '@/components/ExperienceTimeline.astro';
---

<BaseLayout
  title="Experience"
  description="Work history for Zunain Ali Azam — Software Engineer working across frontend and full-stack web development with Next.js, Angular, Node.js, Nest.js, and TypeScript."
>
  <div class="container">
    <PageHeader
      title="Experience"
      intro="From an internship building hiring flows to dashboards, framework migrations and bilingual platforms used by 80,000+ people."
    />

    <ExperienceTimeline />

    <p class="mt-14 text-ink/80">
      Education: B.S. Computer Science, University of Karachi, 2021 to 2024.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/contact" class="btn-primary">Get in touch</a>
      <a href="/resume" class="btn-secondary">Resume (PDF)</a>
    </div>
  </div>
</BaseLayout>
