---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
---

<BaseLayout title="Message Sent" description="Your message has been sent.">
  <div class="container">
    <PageHeader
      title="Message sent"
      intro="Thanks for getting in touch. Your message is in my inbox, and I'll reply within a day."
    >
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn-primary">Back to home</a>
        <a href="/projects" class="btn-secondary">See my work</a>
      </div>
    </PageHeader>
  </div>
</BaseLayout>
