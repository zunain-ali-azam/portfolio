---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Stack from '@/components/Stack.astro';
import Faq from '@/components/Faq.astro';
import { aboutFaqs } from '@/data/faqs';

const certifications = [
  {
    name: 'AI for Everyone',
    issuer: 'DeepLearning.AI',
    year: '2024',
    url: 'https://www.coursera.org/account/accomplishments/certificate/3DS2L97WJQKU',
  },
  {
    name: 'JavaScript Algorithms and Data Structures',
    issuer: 'freeCodeCamp',
    year: '2023',
    url: 'https://www.freecodecamp.org/certification/zunain_azam/javascript-algorithms-and-data-structures',
  },
  {
    name: 'Python Fundamentals',
    issuer: 'DataCamp',
    year: '2023',
    url: null,
  },
  {
    name: 'Web Development with React and MongoDB',
    issuer: 'Udemy',
    year: '2023',
    url: 'https://www.udemy.com/certificate/UC-c26bd80f-ce34-4b3a-8739-2d29994e2e24/',
  },
];

const activities = [
  {
    org: 'B17 Fund Initiative',
    role: 'Volunteer',
    period: 'Feb 2025 – Present',
    detail: 'Conducting mock interviews, mentoring students, and supporting career-readiness programs.',
  },
  {
    org: 'Google Developers Student Club — UOK',
    role: 'Public Relations Lead',
    period: 'Jan 2023 – Sep 2023',
    detail: 'Led outreach and organised technical workshops engaging 250+ students, connecting them with mentorship and career opportunities.',
  },
];
---

<BaseLayout
  title="About"
  description="About Zunain Ali Azam: full-stack developer in Karachi, co-founder of Calyndrs and software engineer at IOMechs. Stack, education and certifications."
>
  <div class="container">
    <PageHeader title="About" />

    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1fr)] lg:gap-16">
      <img
        src="/profile.webp"
        alt="Zunain Ali Azam"
        width="760"
        height="727"
        fetchpriority="high"
        class="w-full max-w-xl aspect-[4/4.4] object-cover object-[50%_25%] rounded-2xl bg-tint lg:sticky lg:top-24 self-start"
      />

      <div>
        <p class="text-[1.25rem] sm:text-4xl font-medium tracking-[-0.035em] leading-[1.12]">
          I'm Zunain Ali Azam, a full-stack developer based in Karachi, Pakistan, with over two years
          of experience building for the web.
        </p>
        <div class="prose-site max-w-[60ch] mt-8">
          <p>
            I work across Next.js, Angular, Node.js and Nest.js: reusable UI architecture and backend
            services, backed by unit, integration and end-to-end tests, performance work, technical SEO
            and CI/CD-driven deployments.
          </p>
          <p>
            In 2026 I co-founded <a href="/projects/calyndrs">Calyndrs</a>, an event management and
            discovery platform, and I've been part of the team building it from the first idea to launch.
          </p>
          <p>
            I'm also a software engineer at <a href="https://iomechs.com" target="_blank" rel="noopener">IOMechs</a>,
            where I work with the team on Estenarh, AZM and NowCut. There I led Estenarh's Angular 14 to 17
            and Next.js 14 to 16 migrations and the performance and SEO work that took its website's
            Lighthouse score from 70 to 99. I've also built bilingual English/Arabic (LTR/RTL) interfaces,
            and dashboards that replaced manual reporting and cut the effort by about 30–40%.
          </p>
        </div>

        <dl class="mt-10 grid sm:grid-cols-3 gap-px bg-rule border border-rule rounded-2xl overflow-hidden">
          <div class="bg-paper p-5"><dt class="text-sm text-mut">Based in</dt><dd class="mt-1">Karachi, Pakistan (UTC+5)</dd></div>
          <div class="bg-paper p-5"><dt class="text-sm text-mut">Working on</dt><dd class="mt-1">Calyndrs, as co-founder, and IOMechs</dd></div>
          <div class="bg-paper p-5"><dt class="text-sm text-mut">Availability</dt><dd class="mt-1 flex items-start gap-2"><span class="mt-[0.55em] w-2 h-2 shrink-0 rounded-full bg-now" aria-hidden="true"></span><span>Open to remote work and relocation</span></dd></div>
        </dl>
      </div>
    </div>

    <section class="mt-24 sm:mt-36">
      <h2 class="type-section mb-10">What I work with</h2>
      <Stack />
    </section>

    <section class="mt-24 sm:mt-32">
      <h2 class="type-section mb-10">Education</h2>
      <div class="border-t border-rule py-6 grid sm:grid-cols-[9rem_minmax(0,1fr)] gap-x-8 gap-y-1">
        <p class="text-sm text-mut sm:pt-1"><time>2021</time> to <time>2024</time></p>
        <div>
          <p class="type-item">B.S. Computer Science</p>
          <p class="mt-1 text-ink/80">University of Karachi</p>
        </div>
      </div>
    </section>

    <section class="mt-24 sm:mt-32">
      <h2 class="type-section mb-10">Certifications</h2>
      <ul class="border-b border-rule">
        {certifications.map((cert) => (
          <li data-reveal="rule" class="border-t border-rule py-5 grid grid-cols-[minmax(0,1fr)_auto] sm:grid-cols-[9rem_minmax(0,1fr)_auto] gap-x-8 gap-y-1 items-baseline">
            <time class="hidden sm:block text-sm text-mut">{cert.year}</time>
            <div>
              <p class="font-medium">{cert.name}</p>
              <p class="text-sm text-mut mt-0.5">{cert.issuer}<span class="sm:hidden">, {cert.year}</span></p>
            </div>
            {cert.url ? (
              <a href={cert.url} target="_blank" rel="noopener noreferrer" class="link text-sm" aria-label={`Verify ${cert.name} certificate`}>
                Verify
              </a>
            ) : <span />}
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-24 sm:mt-32">
      <h2 class="type-section mb-10">Community</h2>
      <ul class="border-b border-rule">
        {activities.map((a) => (
          <li data-reveal="rule" class="border-t border-rule py-6 grid sm:grid-cols-[9rem_minmax(0,1fr)] gap-x-8 gap-y-1">
            <p class="text-sm text-mut sm:pt-1">{a.period}</p>
            <div>
              <p class="type-item">{a.role}, {a.org}</p>
              <p class="mt-2 text-ink/80 max-w-[62ch]">{a.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <Faq section={aboutFaqs} />
</BaseLayout>
