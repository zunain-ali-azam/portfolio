---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Stack from '@/components/Stack.astro';

const certifications = [
  {
    name: 'AI for Everyone',
    issuer: 'Deeplearning.AI',
    year: '2024',
    url: 'https://www.coursera.org/account/accomplishments/certificate/3DS2L97WJQKU',
  },
  {
    name: 'JavaScript Algorithms and Data Structures',
    issuer: 'FreeCodeCamp',
    year: '2023',
    url: 'https://www.freecodecamp.org/certification/zunain_azam/javascript-algorithms-and-data-structures',
  },
  {
    name: 'Python Fundamentals',
    issuer: 'Datacamp',
    year: '2023',
    url: null,
  },
  {
    name: 'Web Development with React and MongoDB',
    issuer: 'Udemy',
    year: '2023',
    url: 'https://www.udemy.com/certificate/UC-c26bd80f-ce34-4b3a-8739-2d29994e2e24/',
  },
];

const activities = [
  {
    org: 'B17 Fund Initiative',
    role: 'Volunteer',
    period: 'Feb 2025 – Present',
    detail: 'Conducting mock interviews, mentoring students, and supporting career-readiness programs.',
  },
  {
    org: 'Google Developers Student Club — UOK',
    role: 'Public Relations Lead',
    period: 'Jan 2023 – Sep 2023',
    detail: 'Led outreach and organised technical workshops engaging 250+ students, connecting them with mentorship and career opportunities.',
  },
];
---

<BaseLayout
  title="About"
  description="Learn more about Zunain Ali Azam — a Software Engineer building scalable web applications across the frontend and backend with Next.js, Angular, Node.js, Nest.js, and TypeScript."
>
  <div class="container">
    <PageHeader title="About" />

    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-20">
      <div class="prose-site max-w-[64ch]">
        <p class="!text-xl sm:!text-2xl !leading-snug !text-ink">
          I'm Zunain Ali Azam, a Software Engineer based in Karachi, Pakistan, with nearly two years
          of experience in frontend and full-stack web development.
        </p>
        <p>
          I work across Next.js, Angular, Node.js, and Nest.js — building reusable UI architectures and
          backend services, and backing them with unit, integration, and end-to-end tests, performance
          work, technical SEO, and CI/CD-driven deployments.
        </p>
        <p>
          Currently at <a href="https://iomechs.com" target="_blank" rel="noopener">IOMechs</a>,
          I work across multiple live products: maintaining and evolving Admin dashboards on
          Estenarh (80,000+ users), building inventory and POS workflows on AZM, and stabilizing
          the NowCut platform. I've led Angular v14→v17 and Next.js v14→v16 migrations,
          resolved technical SEO issues, delivered bilingual English/Arabic (LTR/RTL) interfaces, and
          built analytical dashboards that replaced manual reporting for client teams — cutting
          reporting effort by ~30–40%.
        </p>
      </div>

      <aside class="self-start rounded-xl bg-tint p-6">
        <dl class="space-y-4">
          <div><dt class="text-sm text-mut">Based in</dt><dd>Karachi, Pakistan (UTC+5)</dd></div>
          <div><dt class="text-sm text-mut">Working at</dt><dd>IOMechs</dd></div>
          <div><dt class="text-sm text-mut">Availability</dt><dd class="inline-flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-now" aria-hidden="true"></span>Open to remote work and relocation</dd></div>
        </dl>
      </aside>
    </div>

    <section class="mt-24">
      <h2 class="type-section mb-6">What I work with</h2>
      <Stack />
    </section>

    <section class="mt-20">
      <h2 class="type-section mb-6">Education</h2>
      <div class="border-t border-rule py-6 grid sm:grid-cols-[9rem_minmax(0,1fr)] gap-x-8 gap-y-1">
        <p class="text-sm text-mut sm:pt-1"><time>2021</time> to <time>2024</time></p>
        <div>
          <p class="type-item">B.S. Computer Science</p>
          <p class="mt-1 text-ink/80">University of Karachi</p>
        </div>
      </div>
    </section>

    <section class="mt-20">
      <h2 class="type-section mb-6">Certifications</h2>
      <ul class="border-b border-rule">
        {certifications.map((cert) => (
          <li class="border-t border-rule py-5 grid grid-cols-[minmax(0,1fr)_auto] sm:grid-cols-[9rem_minmax(0,1fr)_auto] gap-x-8 gap-y-1 items-baseline">
            <time class="hidden sm:block text-sm text-mut">{cert.year}</time>
            <div>
              <p class="font-medium">{cert.name}</p>
              <p class="text-sm text-mut mt-0.5">{cert.issuer}<span class="sm:hidden">, {cert.year}</span></p>
            </div>
            {cert.url ? (
              <a href={cert.url} target="_blank" rel="noopener noreferrer" class="link text-sm" aria-label={`Verify ${cert.name} certificate`}>
                Verify
              </a>
            ) : <span />}
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-20">
      <h2 class="type-section mb-6">Community</h2>
      <ul class="border-b border-rule">
        {activities.map((a) => (
          <li class="border-t border-rule py-6 grid sm:grid-cols-[9rem_minmax(0,1fr)] gap-x-8 gap-y-1">
            <p class="text-sm text-mut sm:pt-1">{a.period}</p>
            <div>
              <p class="type-item">{a.role}, {a.org}</p>
              <p class="mt-2 text-ink/80 max-w-[62ch]">{a.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
