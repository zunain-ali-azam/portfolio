---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';

const contactLinks = [
  { label: 'Email',    value: 'zunainazam456@gmail.com',    href: 'mailto:zunainazam456@gmail.com' },
  { label: 'LinkedIn', value: 'linkedin.com/in/zunain-azam', href: 'https://linkedin.com/in/zunain-azam' },
  { label: 'GitHub',   value: 'github.com/zunain-ali-azam',    href: 'https://github.com/zunain-ali-azam' },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Zunain Ali Azam — open to new projects, collaboration, and opportunities."
>
  <div class="container">
    <PageHeader
      title="Get in touch"
      intro="Have a role to share, a project in mind, or a question about my work? I usually reply within a day."
    />

    <div class="grid gap-14 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-20">
      <form action="https://formsubmit.co/zunainazam456@gmail.com" method="POST" class="flex flex-col gap-6 max-w-2xl">
        <input type="hidden" name="_subject" value="New message from portfolio" />
        <input type="hidden" name="_next" value={new URL('/sent', Astro.site).toString()} />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="flex flex-col gap-2">
            <label for="name" class="font-medium">Name</label>
            <input id="name" name="name" type="text" required autocomplete="name" class="form-input" />
          </div>
          <div class="flex flex-col gap-2">
            <label for="email" class="font-medium">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" class="form-input" />
          </div>
        </div>

        <fieldset class="flex flex-col gap-3">
          <legend class="font-medium">What's this about?</legend>
          <div class="flex flex-wrap gap-x-6 gap-y-2">
            {['Full-time role', 'Freelance project', 'Something else'].map((topic, i) => (
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="radio" name="topic" value={topic} required={i === 0} class="w-4 h-4 accent-[rgb(var(--accent))]" />
                {topic}
              </label>
            ))}
          </div>
        </fieldset>

        <div class="flex flex-col gap-2">
          <label for="message" class="font-medium">Message</label>
          <textarea id="message" name="message" required rows="6" placeholder="What are you building, and where could I help?" class="form-input resize-y"></textarea>
        </div>

        <button type="submit" class="btn-primary self-start">Send message</button>
      </form>

      <aside class="self-start">
        <h2 class="font-medium">Or reach me directly</h2>
        <ul class="mt-3 border-b border-rule">
          {contactLinks.map(({ label, value, href }) => (
            <li class="border-t border-rule py-4">
              <p class="text-sm text-mut">{label}</p>
              <a
                href={href}
                target={href.startsWith('mailto') ? undefined : '_blank'}
                rel={href.startsWith('mailto') ? undefined : 'noopener noreferrer'}
                class="link break-all"
              >
                {value}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</BaseLayout>
