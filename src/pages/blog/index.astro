---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PostRow from '@/components/PostRow.astro';
import Faq from '@/components/Faq.astro';
import { writingFaqs } from '@/data/faqs';
import { getCollection } from 'astro:content';
import { readingTime } from '@/lib/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="Writing"
  description="Zunain Ali Azam writes about frontend architecture, full-stack TypeScript, testing, and performance. Practical notes for working developers."
>
  <div class="container">
    <PageHeader
      title="Writing"
      intro="Notes from shipping production software: frontend architecture, framework migrations, testing and performance."
    >
      <p class="mt-4 text-mut">
        I also publish on <a href="https://zunainaliazam.medium.com" target="_blank" rel="noopener noreferrer" class="link text-ink">Medium</a>.
      </p>
    </PageHeader>

    {posts.length === 0 ? (
      <p class="py-16 text-mut border-t border-rule">
        No posts here yet.
      </p>
    ) : (
      <div class="border-b border-rule">
        {posts.map((post) => (
          <PostRow
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            slug={post.slug}
            minutes={readingTime(post.body)}
          />
        ))}
      </div>
    )}
  </div>

  <Faq section={writingFaqs} primary={{ href: '/contact', label: 'Send a question' }} secondary={{ href: '/contact#book', label: 'Book a call' }} />
</BaseLayout>
