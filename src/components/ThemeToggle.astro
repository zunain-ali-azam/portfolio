---
// Cycles System → Light → Dark. The icon shows the current preference; the head script sets
// data-theme-pref before first paint so the right icon shows without a flash.
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Theme: system. Switch to light theme"
  title="Theme: system"
  class="press inline-flex items-center justify-center w-9 h-9 rounded-md border border-control text-ink hover:border-ink transition-[border-color,transform] duration-100 active:scale-[0.94]"
>
  <!-- System -->
  <svg class="theme-icon theme-icon-system" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="4" width="18" height="12" rx="2" />
    <path d="M8 20h8M12 16v4" />
  </svg>
  <!-- Light -->
  <svg class="theme-icon theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <!-- Dark -->
  <svg class="theme-icon theme-icon-dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" />
  </svg>
</button>

<style>
  .theme-icon {
    display: none;
  }
  :global(html[data-theme-pref='system']) .theme-icon-system,
  :global(html[data-theme-pref='light']) .theme-icon-light,
  :global(html[data-theme-pref='dark']) .theme-icon-dark {
    display: block;
  }
</style>

<script>
  type Pref = 'system' | 'light' | 'dark';
  const ORDER: Pref[] = ['system', 'light', 'dark'];
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');
  const systemDark = matchMedia('(prefers-color-scheme: dark)');

  const currentPref = (): Pref => (root.dataset.themePref as Pref) ?? 'system';

  const apply = (pref: Pref) => {
    root.dataset.themePref = pref;
    root.classList.toggle('dark', pref === 'dark' || (pref === 'system' && systemDark.matches));
    const next = ORDER[(ORDER.indexOf(pref) + 1) % ORDER.length];
    btn?.setAttribute('aria-label', `Theme: ${pref}. Switch to ${next} theme`);
    btn?.setAttribute('title', `Theme: ${pref}`);
  };

  // Cross-fade the switch so the whole screen doesn't change brightness in one frame
  const applyWithFade = (pref: Pref) => {
    if (!document.startViewTransition) return apply(pref);
    root.classList.add('theme-switching');
    const transition = document.startViewTransition(() => apply(pref));
    transition.finished.finally(() => root.classList.remove('theme-switching'));
  };

  apply(currentPref());

  btn?.addEventListener('click', () => {
    const next = ORDER[(ORDER.indexOf(currentPref()) + 1) % ORDER.length];
    try {
      if (next === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', next);
    } catch {
      // Storage can be blocked (private mode); the choice still applies for this page
    }
    applyWithFade(next);
  });

  // In System mode, follow the OS when it switches between light and dark
  systemDark.addEventListener('change', () => {
    if (currentPref() === 'system') applyWithFade('system');
  });
</script>
