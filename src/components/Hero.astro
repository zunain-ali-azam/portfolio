---
import SplitText from './SplitText.astro';

const email = 'zunainazam456@gmail.com';
---

<section class="container pt-14 sm:pt-24 pb-20 sm:pb-28">
  <SplitText as="h1" class="type-hero max-w-[17ch]" text="I build, upgrade and fix the web apps teams rely on." delay={100} />

  <div class="mt-12 sm:mt-20 grid gap-10 md:grid-cols-2 md:items-end">
    <div class="order-2 md:order-1" data-reveal style="--reveal-delay: 750ms">
      <div class="flex items-center gap-3">
        <a href={`mailto:${email}`} class="text-lg sm:text-xl font-medium hover:text-accent transition-colors break-all">{email}</a>
        <button
          id="copy-email"
          type="button"
          data-email={email}
          class="press shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-full border border-control text-ink hover:border-ink transition-[border-color,transform] duration-100 active:scale-[0.94]"
          aria-label="Copy email address"
          title="Copy email address"
        >
          <svg class="copy-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" />
          </svg>
          <svg class="done-icon hidden" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12.5l4.5 4.5L19 7.5" />
          </svg>
        </button>
        <span id="copy-status" class="text-sm text-now" role="status"></span>
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/contact" class="btn-primary">Get in touch</a>
        <a href="/projects" class="btn-secondary">See my work</a>
      </div>
    </div>

    <p data-reveal style="--reveal-delay: 600ms" class="order-1 md:order-2 text-xl sm:text-2xl leading-snug tracking-[-0.015em] text-ink/85 max-w-[34ch] md:justify-self-end">
      Full-stack developer in Karachi. Open to remote roles, relocation and freelance projects.
    </p>
  </div>
</section>

<script>
  const btn = document.getElementById('copy-email');
  const status = document.getElementById('copy-status');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.email ?? '');
    } catch {
      return; // Clipboard blocked: the address is still a mailto link right beside it
    }
    btn.querySelector('.copy-icon')?.classList.add('hidden');
    btn.querySelector('.done-icon')?.classList.remove('hidden');
    if (status) status.textContent = 'Copied';
    setTimeout(() => {
      btn.querySelector('.copy-icon')?.classList.remove('hidden');
      btn.querySelector('.done-icon')?.classList.add('hidden');
      if (status) status.textContent = '';
    }, 1800);
  });
</script>
