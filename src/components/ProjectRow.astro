---
interface Props {
  title: string;
  description: string;
  tech: string[];
  slug: string;
  yearCompleted: string | number;
  image?: string;
}

const { title, description, tech, slug, yearCompleted, image } = Astro.props;
const isLogo = image?.toLowerCase().includes('logo');
---

<a
  href={`/projects/${slug}`}
  class="group grid gap-x-8 gap-y-4 py-7 border-t border-rule sm:grid-cols-[minmax(0,1fr)_13rem]"
>
  <div class="min-w-0">
    <div class="flex items-baseline justify-between gap-4">
      <h3 class="type-item group-hover:text-accent transition-colors">{title}</h3>
      <time class="text-sm text-mut sm:hidden">{yearCompleted}</time>
    </div>
    <p class="mt-2 text-ink/80 max-w-[62ch] line-clamp-2">{description}</p>
    <p class="mt-3 text-sm text-mut">
      <time class="hidden sm:inline">{yearCompleted}, </time>{tech.join(', ')}
    </p>
  </div>

  {image && (
    <div
      class:list={[
        'hidden sm:block aspect-[16/10] rounded-lg overflow-hidden border border-rule',
        isLogo ? 'bg-white' : 'bg-tint',
      ]}
    >
      <img
        src={image}
        alt=""
        loading="lazy"
        decoding="async"
        class:list={['w-full h-full', isLogo ? 'object-contain p-6' : 'object-cover object-top']}
      />
    </div>
  )}
</a>
