---
interface Props {
  title: string;
  intro?: string;
  href?: string;
  linkLabel?: string;
}

const { title, intro, href, linkLabel = 'View all' } = Astro.props;
---

<div class="mb-8 flex flex-wrap items-end justify-between gap-x-6 gap-y-3" data-reveal>
  <div>
    <h2 class="type-section">{title}</h2>
    {intro && <p class="mt-2 text-mut max-w-[60ch]">{intro}</p>}
  </div>
  {href && <a href={href} class="link shrink-0">{linkLabel}</a>}
</div>
