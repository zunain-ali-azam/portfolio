---
// Large entry for projects with an image: the product leads, the words follow. Logos sit on white.
interface Props {
  title: string;
  description: string;
  tech: string[];
  category?: string[];
  slug: string;
  yearCompleted: string | number;
  image: string;
  /** Set for team projects at an employer: the card then leads with my part, not the product */
  employer?: string;
  myPart?: string;
  /** Image, title and one line only; the full write-up lives on the project page */
  compact?: boolean;
}

const { title, description, tech, category = [], slug, yearCompleted, image, employer, myPart, compact = false } = Astro.props;
const isLogo = image.toLowerCase().includes('logo');
---

<a href={`/projects/${slug}`} class="group block">
  <div
    class:list={[
      'aspect-[4/3]',
      'rounded-2xl overflow-hidden transition-[outline-color] duration-300 outline outline-1 -outline-offset-1 outline-rule group-hover:outline-accent',
      isLogo ? 'bg-white' : 'bg-tint',
    ]}
    style={`view-transition-name: project-image-${slug}`}
    data-reveal="screen"
  >
    <img
      src={image}
      alt={isLogo ? '' : `${title} screenshot`}
      loading="lazy"
      decoding="async"
      class:list={['feature-img w-full h-full', isLogo ? 'object-contain p-[18%]' : 'object-cover object-center']}
    />
  </div>
  <div data-reveal>
    <div class="mt-5 flex items-baseline justify-between gap-4">
      <h3 class="text-xl sm:text-[2rem] font-semibold tracking-[-0.035em] leading-tight group-hover:text-accent transition-colors duration-300" style={`view-transition-name: project-title-${slug}`}>{title}</h3>
      <time class="text-mut">{yearCompleted}</time>
    </div>
    <p class="mt-1 text-mut">{employer ? `Team project at ${employer}` : category.join(', ')}</p>
    {(!compact || myPart) && <p class="mt-3 text-ink/80 max-w-[58ch] line-clamp-3">{myPart ?? description}</p>}
    {!compact && <p class="mt-3 text-sm text-mut">{tech.join(', ')}</p>}
  </div>
</a>
