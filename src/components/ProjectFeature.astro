---
// Large entry for projects with a real screenshot: the product leads, the words follow
interface Props {
  title: string;
  description: string;
  tech: string[];
  slug: string;
  yearCompleted: string | number;
  image: string;
}

const { title, description, tech, slug, yearCompleted, image } = Astro.props;
---

<a href={`/projects/${slug}`} class="group block">
  <div
    class="aspect-[16/10] rounded-xl overflow-hidden border border-rule bg-tint transition-[border-color,transform] duration-300 group-hover:border-accent group-hover:-translate-y-1"
    style={`view-transition-name: project-image-${slug}`}
    data-reveal="screen"
  >
    <img
      src={image}
      alt={`${title} screenshot`}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover object-top"
    />
  </div>
  <div data-reveal>
  <div class="mt-5 flex items-baseline justify-between gap-4">
    <h3 class="type-item group-hover:text-accent transition-colors" style={`view-transition-name: project-title-${slug}`}>{title}</h3>
    <time class="text-sm text-mut">{yearCompleted}</time>
  </div>
  <p class="mt-2 text-ink/80 line-clamp-3">{description}</p>
  <p class="mt-3 text-sm text-mut">{tech.join(', ')}</p>
  </div>
</a>
