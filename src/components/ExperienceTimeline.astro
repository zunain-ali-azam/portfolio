---
import experience from '@/data/experience.json';

interface Props {
  preview?: boolean;
}

const { preview = false } = Astro.props;
const yearOf = (d: string) => d.split(' ').pop();
---

<!-- A real sequence, so it gets a line: newest role first, current role marked in turquoise -->
<ol class="relative border-s-2 border-rule ms-1.5">
  {experience.map((job) => (
    <li class="relative ps-7 sm:ps-10 pb-10 last:pb-0">
      <span
        class:list={[
          'absolute -start-[9px] top-1.5 w-4 h-4 rounded-full border-[3px] border-paper',
          job.current ? 'bg-now' : 'bg-mut/50',
        ]}
        aria-hidden="true"
      ></span>

      <p class="text-sm text-mut">
        <time>{job.start}</time> to <time>{job.current ? 'now' : job.end}</time>{job.current && <span class="text-now font-medium">, current role</span>}
      </p>
      <h3 class="mt-1 type-item">{job.role}, {job.company}</h3>
      <p class="mt-1 text-sm text-mut">{job.location}, {job.type.toLowerCase()}</p>

      <ul class="bullets mt-4 space-y-2 max-w-[68ch]">
        {(preview ? job.bullets.slice(0, 2) : job.bullets).map((b) => <li>{b}</li>)}
      </ul>

      {!preview && <p class="mt-4 text-sm text-mut max-w-[68ch]">{job.tech.join(', ')}</p>}
    </li>
  ))}
</ol>
