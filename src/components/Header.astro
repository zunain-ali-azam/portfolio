---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/projects',   label: 'Work' },
  { href: '/experience', label: 'Experience' },
  { href: '/blog',       label: 'Writing' },
  { href: '/about',      label: 'About' },
  { href: '/contact',    label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<header class="site-header sticky top-0 z-50 bg-paper/85 backdrop-blur-md" style="view-transition-name: site-header">
  <div class="container">
    <div class="flex items-center justify-between h-16 gap-6">
      <a href="/" class="font-semibold tracking-[-0.02em] text-ink hover:text-accent transition-colors">
        Zunain Ali Azam
      </a>

      <!-- Where and when I am: helps a visitor in another time zone judge when I'll reply -->
      <p class="hidden lg:flex items-center gap-6 text-[0.9375rem]">
        <span class="flex items-center gap-2">
          <span class="relative flex w-2 h-2" aria-hidden="true">
            <span class="status-ping absolute inset-0 rounded-full bg-now"></span>
            <span class="relative w-2 h-2 rounded-full bg-now"></span>
          </span>
          Open to work
        </span>
        <span class="text-mut">Karachi <time id="local-time" class="ms-1 text-ink/70"></time></span>
      </p>

      <div class="flex items-center gap-3 md:gap-7">
        <nav class="hidden md:flex items-center gap-6 text-[0.9375rem]" aria-label="Primary">
          {navLinks.map(({ href, label }) => (
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class:list={[
                'py-1 border-b-2 transition-colors',
                isActive(href) ? 'border-accent text-ink' : 'border-transparent text-mut hover:text-ink',
              ]}
            >
              {label}
            </a>
          ))}
        </nav>
        <ThemeToggle />

        <!-- Below md the links collapse into this menu -->
        <button
          id="menu-toggle"
          type="button"
          class="press md:hidden inline-flex items-center justify-center w-9 h-9 rounded-md border border-control text-ink hover:border-ink transition-[border-color,transform] duration-100 active:scale-[0.94]"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <svg class="menu-icon" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path class="menu-icon-top" d="M2 6h14" />
            <path class="menu-icon-bottom" d="M2 12h14" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-menu md:hidden" aria-label="Primary" data-open="false">
    <div class="overflow-hidden">
      <ul class="container pb-4 border-t border-rule">
        {navLinks.map(({ href, label }) => (
          <li class="border-b border-rule last:border-b-0">
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between py-3.5 text-lg',
                isActive(href) ? 'text-accent font-medium' : 'text-ink',
              ]}
            >
              {label}
              {isActive(href) && <span class="w-2 h-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<script>
  // Karachi local time, refreshed each minute
  const clock = document.getElementById('local-time');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Karachi', hour: '2-digit', minute: '2-digit' });
    const tick = () => (clock.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 30_000);
  }

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  const isOpen = () => menu?.dataset.open === 'true';

  toggle?.addEventListener('click', () => setOpen(!isOpen()));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });

  // Close when tapping anywhere outside the header
  document.addEventListener('click', (e) => {
    if (isOpen() && !(e.target as Element).closest('header')) setOpen(false);
  });

  // Close if the viewport widens past the breakpoint where the inline nav returns
  matchMedia('(min-width: 768px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
