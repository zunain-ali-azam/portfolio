---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/projects',   label: 'Work' },
  { href: '/experience', label: 'Experience' },
  { href: '/blog',       label: 'Writing' },
  { href: '/about',      label: 'About' },
  { href: '/contact',    label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<header class="site-header sticky top-0 z-50 bg-paper/85 backdrop-blur-md" style="view-transition-name: site-header">
  <div class="container">
    <div class="flex items-center justify-between h-16 gap-6">
      <a href="/" class="font-semibold tracking-[-0.02em] text-ink hover:text-accent transition-colors">
        Zunain Ali Azam
      </a>

      <!-- Where and when I am: helps a visitor in another time zone judge when I'll reply -->
      <p class="hidden lg:flex items-center gap-6 text-[0.9375rem]">
        <span class="flex items-center gap-2">
          <span class="relative flex w-2 h-2" aria-hidden="true">
            <span class="status-ping absolute inset-0 rounded-full bg-now"></span>
            <span class="relative w-2 h-2 rounded-full bg-now"></span>
          </span>
          Open to work
        </span>
        <span class="text-mut">Karachi <time id="local-time" class="ms-1 text-ink/70"></time></span>
      </p>

      <div class="flex items-center gap-3 md:gap-7">
        <nav class="hidden md:flex items-center gap-6 text-[0.9375rem]" aria-label="Primary">
          {navLinks.map(({ href, label }) => (
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class:list={[
                'py-1 border-b-2 transition-colors',
                isActive(href) ? 'border-accent text-ink' : 'border-transparent text-mut hover:text-ink',
              ]}
            >
              {label}
            </a>
          ))}
        </nav>
        <ThemeToggle />

        <!-- Below md the links collapse into this menu -->
        <button
          id="menu-toggle"
          type="button"
          class="press md:hidden inline-flex items-center justify-center w-9 h-9 rounded-md border border-control text-ink hover:border-ink transition-[border-color,transform] duration-100 active:scale-[0.94]"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <svg class="menu-icon" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path class="menu-icon-top" d="M2 6h14" />
            <path class="menu-icon-bottom" d="M2 12h14" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Below md: a full-screen sheet over the page, under the header bar, ending in a call to action.
       Absolute, not fixed: the header's backdrop blur would make it the containing block anyway. -->
  <nav
    id="mobile-menu"
    class="mobile-menu md:hidden absolute inset-x-0 top-full h-[calc(100dvh-4rem)] overflow-y-auto overscroll-contain bg-paper"
    aria-label="Primary"
    data-open="false"
  >
    <div class="container flex flex-col min-h-full pb-8">
      <ul class="border-t border-rule">
        {navLinks.map(({ href, label }, i) => (
          <li class="mobile-menu-item border-b border-rule" style={`--i: ${i}`}>
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between py-4 text-[1.75rem] font-semibold tracking-[-0.03em]',
                isActive(href) ? 'text-accent' : 'text-ink',
              ]}
            >
              {label}
              {isActive(href) && <span class="w-2 h-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>}
            </a>
          </li>
        ))}
      </ul>

      <div class="mobile-menu-item mt-auto pt-10" style={`--i: ${navLinks.length}`}>
        <p class="flex items-center gap-2 text-mut">
          <span class="w-2 h-2 rounded-full bg-now" aria-hidden="true"></span>
          Open to work, based in Karachi
        </p>
        <a href="/contact" class="btn-primary mt-4 w-full justify-center py-3.5 text-base">Get in touch</a>
        <a href="mailto:zunainazam456@gmail.com" class="mt-4 block text-center text-mut hover:text-ink transition-colors">zunainazam456@gmail.com</a>
      </div>
    </div>
  </nav>
</header>

<script>
  // Karachi local time, refreshed each minute
  const clock = document.getElementById('local-time');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Karachi', hour: '2-digit', minute: '2-digit' });
    const tick = () => (clock.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 30_000);
  }

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    menu.dataset.open = String(open);
    // The sheet covers the page, so the page behind it shouldn't scroll
    document.documentElement.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  const isOpen = () => menu?.dataset.open === 'true';

  toggle?.addEventListener('click', () => setOpen(!isOpen()));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });

  // Close when following a link in the sheet, e.g. to a section of the page already open
  menu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setOpen(false);
  });

  // Close if the viewport widens past the breakpoint where the inline nav returns
  matchMedia('(min-width: 768px)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
