---
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
  { href: '/projects',   label: 'Work' },
  { href: '/experience', label: 'Experience' },
  { href: '/blog',       label: 'Writing' },
  { href: '/about',      label: 'About' },
  { href: '/contact',    label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 bg-paper/90 backdrop-blur-md border-b border-rule" style="view-transition-name: site-header">
  <div class="container">
    <div class="flex items-center justify-between h-16 gap-6">
      <a href="/" class="font-semibold tracking-[-0.02em] text-ink hover:text-accent transition-colors">
        Zunain Ali Azam
      </a>

      <div class="flex items-center gap-7">
        <nav class="hidden md:flex items-center gap-6 text-[15px]" aria-label="Primary">
          {navLinks.map(({ href, label }) => (
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class:list={[
                'py-1 border-b-2 transition-colors',
                isActive(href) ? 'border-accent text-ink' : 'border-transparent text-mut hover:text-ink',
              ]}
            >
              {label}
            </a>
          ))}
        </nav>
        <ThemeToggle />
      </div>
    </div>
  </div>

  <!-- Mobile nav: a scrollable row under the bar -->
  <nav class="md:hidden border-t border-rule overflow-x-auto" aria-label="Primary">
    <div class="container flex items-center gap-5 h-11 w-max min-w-full text-[15px]">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
          class:list={['whitespace-nowrap', isActive(href) ? 'text-accent font-medium' : 'text-mut']}
        >
          {label}
        </a>
      ))}
    </div>
  </nav>
</header>
