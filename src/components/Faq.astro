---
import SplitText from './SplitText.astro';
import type { FaqSection } from '@/data/faqs';

interface Link {
  href: string;
  label: string;
}

interface Props {
  section: FaqSection;
  primary?: Link;
  secondary?: Link;
}

const {
  section: { title, intro, faqs, cta },
  primary = { href: '/contact#book', label: 'Book a 30-minute call' },
  secondary = { href: '/contact', label: 'Send a message' },
} = Astro.props;

// Answers can hold links; search engines get the plain text
const plain = (html: string) => html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: plain(a) },
  })),
};
---

<section class="container mt-24 sm:mt-36" aria-label="Frequently asked questions">
  <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-16">
    <div>
      <SplitText class="type-section max-w-[16ch]" text={title} />
      {intro && <p class="mt-4 text-mut max-w-[40ch]" data-reveal style="--reveal-delay: 250ms">{intro}</p>}
    </div>

    <div class="border-b border-rule">
      {faqs.map(({ q, a }) => (
        <details class="faq border-t border-rule" data-reveal="rule">
          <summary class="flex items-start justify-between gap-6 py-5 sm:py-6 cursor-pointer list-none text-lg sm:text-xl font-medium tracking-[-0.015em] leading-snug transition-colors hover:text-accent">
            {q}
            <svg class="faq-icon shrink-0 mt-1" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M9 3v12M3 9h12" />
            </svg>
          </summary>
          <div class="pb-6 sm:pb-7 pe-10 max-w-[64ch] text-ink/80 leading-relaxed" set:html={a} />
        </details>
      ))}
    </div>
  </div>

  <div class="faq-cta mt-16 sm:mt-24 rounded-2xl bg-accent text-on-accent p-8 sm:p-12 lg:p-16 grid gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end" data-reveal>
    <div>
      <h2 class="text-[1.75rem] sm:text-5xl font-semibold tracking-[-0.04em] leading-[1.05] max-w-[18ch]">{cta.title}</h2>
      <p class="mt-4 text-on-accent/85 max-w-[52ch]">{cta.text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={primary.href} class="btn bg-on-accent text-accent border-on-accent hover:bg-transparent hover:text-on-accent">{primary.label}</a>
      <a href={secondary.href} class="btn border-on-accent/50 text-on-accent hover:border-on-accent">{secondary.label}</a>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqPage)} />
</section>
