---
const links = [
  { label: 'GitHub',   href: 'https://github.com/zunain-ali-azam' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/zunain-azam' },
  { label: 'Medium',   href: 'https://zunainaliazam.medium.com' },
  { label: 'Resume',   href: '/resume' },
];

const year = new Date().getFullYear();

// Pages that are already about contacting me skip the big invitation
const path = Astro.url.pathname.replace(/\/$/, '');
const showInvite = !['/contact', '/sent', '/not-sent'].includes(path);
---

<footer class="mt-24 sm:mt-36 bg-band text-on-band">
  <div class="container pt-16 sm:pt-24 pb-10">
    {showInvite && (
      <div class="mb-16 sm:mb-24">
        <h2 class="text-2xl sm:text-[2rem] font-semibold tracking-[-0.03em] leading-tight">Hiring, or need something built?</h2>
        <p class="mt-3 text-band-mut max-w-[52ch]">Whether it's a full-time role or a freelance project, tell me what you're working on.</p>

        <a href="/contact" class="mt-8 inline-block text-[2.5rem] sm:text-6xl font-semibold tracking-[-0.045em] leading-none text-band-accent underline decoration-band-accent/30 decoration-2 underline-offset-[0.18em] transition-colors hover:text-on-band hover:decoration-on-band/50">
          Get in touch
        </a>
      </div>
    )}

    <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end border-t border-band-rule pt-8">
      <div>
        <a href="mailto:zunainazam456@gmail.com" class="text-xl sm:text-2xl font-medium tracking-[-0.02em] hover:text-band-accent transition-colors break-all">zunainazam456@gmail.com</a>
        <p class="mt-2 text-band-mut">Software engineer in Karachi, Pakistan. Usually replies within a day.</p>
      </div>

      <div class="flex flex-col gap-4 md:items-end">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {links.map(({ label, href }) => (
            <li>
              <a
                href={href}
                target={href.startsWith('http') ? '_blank' : undefined}
                rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="hover:text-band-accent transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
        <p class="text-sm text-band-mut">&copy; {year} Zunain Ali Azam</p>
      </div>
    </div>
  </div>
</footer>
